{
  "name": "tabax-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Migration React du site tabax-construire.com (fidélité design via réutilisation du CSS/JS d'origine).",
  "scripts": {
    "extract": "node scripts/extract.mjs",
    "sync-assets": "node scripts/sync-assets.mjs",
    "prepare-mirror": "npm run extract && npm run sync-assets",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cheerio": "^1.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
